# SQLite database path (the parent directory is bind-mounted in Docker Compose)
DATABASE_URL=./data/ohttps-deploy.db

# Optional Turso/libSQL remote database
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=replace-me

# Immutable certificate-version directories and the `current` pointer
CERTIFICATE_STORAGE_DIR=./data/certs

# Retention archives are written before historic logs and audit events are removed
LOG_ARCHIVE_DIR=./data/logs

# Required in production; use a long random value for signing admin sessions
AUTH_SECRET=change-me-in-production

# Public URL used by authentication and same-origin CSRF checks behind a reverse proxy
BETTER_AUTH_URL=https://certs.example.com

# Optional Pocket ID login. Configure all four together; password login remains available.
# Exact HTTPS issuer of Pocket ID (without trailing slash)
# POCKET_ID_ISSUER=https://id.example.com
# POCKET_ID_CLIENT_ID=your-oidc-client-id
# POCKET_ID_CLIENT_SECRET=your-oidc-client-secret
# Only this Pocket ID user ID (OIDC sub) can sign in as the existing admin
# POCKET_ID_ADMIN_SUB=your-pocket-id-user-id
