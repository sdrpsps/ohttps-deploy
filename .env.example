# SQLite database path (the parent directory is mounted as a persistent volume)
DATABASE_URL=./data/ohttps-deploy.db

# Optional Turso/libSQL remote database
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=replace-me

# Immutable certificate-version directories and the `current` pointer
CERTIFICATE_STORAGE_DIR=./data/certs

# Required in production; use a long random value for signing admin sessions
AUTH_SECRET=change-me-in-production
